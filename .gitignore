# terraform
.terraform/
# the only piece of the S3 backend configuration that is not committed: the
# generated bucket name (infra/backend.hcl.example is the template)
backend.hcl
*.tfstate
*.tfstate.backup
terraform.tfvars
infra/outputs.json

# python
.venv/
__pycache__/
*.pyc

# results: committed JSONs live in results/<fecha>/; huge raw exports do not
results/raw-large/
# ...and neither do the two terraform outputs a human leaves for the runner:
# both carry the sandbox account id. results/images.json is NOT here on purpose,
# it only has the tag and the digests.
results/*/cluster.json
results/*/ecr.json

# secrets / local
.env
.DS_Store

# apps/build-multiarch.sh local OCI tarball output (PUSH=0)
apps/build-out/

# slides working files
slides/assets/raw/
# superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/

# terraform plan files and state locks (may carry account data)
*.tfplan
.terraform.tfstate.lock.info

# APerf: the tarball is the record; the extracted report is regenerated with `aperf report`
results/**/aperf_record_*/
results/*/inventory-raw/

# demo/sanitize-check.sh client/codename word list: holds the names it guards, never commit
.sanitize-extra

# APerf HTML reports (~330 MB): regenerate from results/ tarballs, see slides/assets/README.md
slides/assets/aperf/

# APerf raw tarballs (~1.36 GB, 231 files): published as the GitHub Release `aperf-raw-2026-09`,
# see README. The four from the 2026-09-04 gate were committed before this rule and stay tracked.
results/**/aperf/*.tar.gz
