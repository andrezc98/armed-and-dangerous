# Copy to backend.hcl (git-ignored) and fill in with the real bucket name.
#
#   terraform -chdir=infra init -backend-config=backend.hcl
#
# The rest of the backend (key, region, encrypt, use_lockfile) is committed in
# versions.tf; only the bucket name lives here, because it is generated by
# infra/bootstrap/ and this repository does not carry it. Get it with:
#
#   terraform -chdir=infra/bootstrap output -raw state_bucket
#
# The value below is not a bucket.
bucket = "aws-aad-tfstate-REPLACE-ME"
